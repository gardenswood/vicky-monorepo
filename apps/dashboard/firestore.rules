rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.get('role', 'viewer');
    }
    function isAdmin() {
      return isAuth() && role() == 'admin';
    }
    function isOperator() {
      return isAuth() && role() in ['admin', 'operador'];
    }
    function isViewer() {
      return isAuth() && role() in ['admin', 'operador', 'viewer'];
    }

    // ── Usuarios del dashboard ────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if isViewer();
      allow create, update, delete: if isAdmin();
    }

    // ── Chats (solo lectura para viewers, escritura para operators) ────────
    match /chats/{chatId} {
      allow read: if isViewer();
      allow write: if isOperator();

      match /mensajes/{msgId} {
        allow read: if isViewer();
        // Operadores pueden marcar mensajes (ej: silenciar bot)
        allow write: if isOperator();
      }
    }

    // ── Clientes ──────────────────────────────────────────────────────────
    match /clientes/{tel} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    // ── Config (prompts, general) ─────────────────────────────────────────
    match /config/{docId} {
      allow read: if isViewer();
      allow write: if isOperator();

      // Historial de versiones de prompts
      match /versiones/{versionId} {
        allow read: if isViewer();
        allow write: if isOperator();
      }

      match /borradores/{borradorId} {
        allow read: if isViewer();
        allow write: if isOperator();
      }
    }

    // ── Servicios (precios) ───────────────────────────────────────────────
    match /servicios/{svcId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    // ── Cola de leña ──────────────────────────────────────────────────────
    match /colaLena/{pedidoId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    // ── Consultas manuales de leña por zona ───────────────────────────────
    match /consultasLena/{consultaId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    // ── Agenda y registros operativos ─────────────────────────────────────
    match /entregas_agenda/{entregaId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    match /datos_entrega_cliente/{registroId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    match /lid_mapeo/{lidId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    match /rutas_logistica/{rutaId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    // ── Mensajes programados para el bot ──────────────────────────────────
    match /mensajes_programados/{progId} {
      allow read: if isViewer();
      allow write: if isOperator();
    }

    // ── Skills internas de Vicky ──────────────────────────────────────────
    match /vicky_skills/{skillId} {
      allow read: if isViewer();
      allow write: if isOperator();

      match /versiones/{versionId} {
        allow read: if isViewer();
        allow write: if isOperator();
      }
    }

    // ── Asistente del dashboard: auditoría y cola de cambios ───────────────
    // Las escrituras operativas se hacen vía API server-side con Admin SDK.
    match /assistant_runs/{runId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /assistant_changes/{changeId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /change_requests/{requestId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ── Log de mensajes (analytics) ───────────────────────────────────────
    // Solo lectura para el dashboard; el bot escribe vía service account (admin SDK)
    match /mensajes_log/{logId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ── Denegar todo lo demás ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
