{
  "name": "vicky-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/bot",
    "apps/dashboard"
  ],
  "scripts": {
    "bot:start": "npm --prefix apps/bot start",
    "bot:verify": "npm --prefix apps/bot run verify",
    "dashboard:dev": "npm --prefix apps/dashboard run dev",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "dashboard:start": "npm --prefix apps/dashboard run start",
    "dashboard:lint": "npm --prefix apps/dashboard run lint"
  }
}

